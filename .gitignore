# ==============================================================================
# Unified .gitignore for IELTS Learning Web Project (Root, Backend & Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java & Maven (Backend)
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
**/maven-wrapper.jar

# JaCoCo & Test Reports
jacoco.exec
**/jacoco.exec
**/target/site/

# ------------------------------------------------------------------------------
# 2. Node.js, Vite & React (Frontend)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
.vite/
**/.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
application-local.properties
**/application-local.properties
application-*.local.properties
**/application-*.local.properties

# ------------------------------------------------------------------------------
# 4. Logs & Temp Files
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
bin/
**/bin/
temp/
tmp/

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
**/.idea/
*.iml
**/*.iml
.vscode/
**/.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
