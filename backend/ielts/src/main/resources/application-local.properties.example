# ===================================================================
# LOCAL ENVIRONMENT CONFIG TEMPLATE (COPY TO application-local.properties)
# ===================================================================

# 1. Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 2. JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# 3. OpenAI API Key
OPENAI_API_KEY=your_openai_api_key

# 4. Email SMTP
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# 5. Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# 6. Microsoft Azure Speech API
AZURE_SPEECH_KEY=your_azure_speech_key

# 7. VNPay Payment Gateway
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECRET_KEY=your_vnpay_secret_key

# 8. MongoDB Database URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ielts_db

# 9. Google Gemini & Groq API Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
